# Mailchimp email capture integration
# Get these from your Mailchimp account:
#   API key: Account > Extras > API Keys
#   List ID: Audience > Settings > Audience name & defaults > Audience ID
#   DC: last part of your API key after the dash, e.g. "us1" in "abc123-us1"

MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-mailchimp-audience-id
MAILCHIMP_DC=us1
